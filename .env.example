# Google Gemini API key (server-side only)
GEMINI_API_KEY=

# Optional: override the Gemini model used by the server.
GEMINI_MODEL=gemini-3.8-flash

# Supabase server-side database + pgvector RAG
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional Gemini embedding settings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
