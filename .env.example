# Required: server-side Gemini API key (never expose as VITE_*)
GEMINI_API_KEY=

# Optional: override the Gemini model used by the server.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: server-side Supabase + pgvector RAG.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional Gemini embedding settings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Optional AI provider fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
